# DB_SSL_CA="-----BEGIN CERTIFICATE-----
# ...certificate content...
# -----END CERTIFICATE-----"
DB_SSL_CA=
DB_SSL_VERIFY_CERT=true
DB_CONNECT_TIMEOUT=10
