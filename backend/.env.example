OPENAI_API_KEY=your-server-key
OPENAI_AVATAR_MODEL=gpt-4.1-mini
AVATAR_SERVICE_TOKEN=replace-with-a-long-random-local-token

# Aiven MySQL: configuration prepared; SQL integration is still pending.
DB_HOST=your-service.aivencloud.com
DB_PORT=10472
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=BD_my_daily_routine
