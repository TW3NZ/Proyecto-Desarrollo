OPENAI_API_KEY=your-server-key
OPENAI_AVATAR_MODEL=gpt-4.1-mini
AVATAR_SERVICE_TOKEN=replace-with-a-long-random-local-token

# Aiven MySQL used by registration and login.
DB_HOST=your-service.aivencloud.com
DB_PORT=10472
DB_USER=avnadmin
DB_PASSWORD=
DB_NAME=BD_my_daily_routine
# Paste the complete PEM inside double quotes, preserving actual newlines.
# DB_SSL_CA="-----BEGIN CERTIFICATE-----
# ...certificate content...
# -----END CERTIFICATE-----"
DB_SSL_CA=
DB_SSL_VERIFY_CERT=true
DB_CONNECT_TIMEOUT=10

# JWT authentication; independent from AVATAR_SERVICE_TOKEN.
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Optional fallback for non-local admin access. Loopback access needs no password.
# Set false on Render to keep the administrative panel local only.
ADMIN_ENABLED=true
ADMIN_USER=admin
ADMIN_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD_OF_AT_LEAST_24_CHARACTERS
# Exact frontend origins allowed for local Live Server (no wildcard).
ADMIN_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:3000,http://localhost:3000
